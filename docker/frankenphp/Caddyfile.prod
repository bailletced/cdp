{
	# TLS est géré par Traefik en production (T37) ; Caddy écoute en HTTP interne.
	auto_https off

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME::80} {
	log {
		{$CADDY_SERVER_LOG_OPTIONS}
	}

	root /app/api/public
	encode zstd br gzip

	# Cache long pour les fichiers statiques hachés (Vite).
	@hashed {
		path /assets/* /fonts/*
		file
	}
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Routes API et système → front controller Symfony (qui route sur REQUEST_URI).
	# Comme en dev : on réécrit vers index.php, le handler php exécute alors
	# root/index.php dans le worker FrankenPHP.
	@apiRoutes {
		path /api* /auth* /unsubscribe* /health /bundles/*
	}
	rewrite @apiRoutes index.php

	@frontController path index.php
	php @frontController {
		{$FRANKENPHP_SITE_CONFIG}
		worker {
			file ./public/index.php
		}
	}

	# Fichiers statiques existants (hors routes API) servis directement.
	@staticFile {
		file
		not path /api* /auth* /unsubscribe* /health /bundles/*
	}
	file_server @staticFile {
		hide *.php
	}

	# SPA : repli vers index.html pour les routes profondes (ex. /my-space rechargé).
	@spaFallback {
		not file {path}
		not path /api* /auth* /unsubscribe* /health /bundles/* /assets/* /fonts/*
	}
	rewrite @spaFallback index.html
	file_server
}
