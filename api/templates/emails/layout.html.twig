{# Base HTML layout for all emails (F02-T13).
   The « aube » identity of the site (src/index.css, docs/design/theme.md):
   warm ivory #faf7f0, deep brown-gold accent #7c4a1f, text #2b2118 on white,
   separators #e9e0d0. Heading faces lean on Georgia (as the site leans on
   Alegreya), the running text on the platform sans (as Atkinson does).
   Table-based markup for e-mail clients; the CSS is inlined by the
   inline_css filter. #}
{% apply inline_css %}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ communion_name }}{% endblock %}</title>
    <style>
        body { margin: 0; padding: 0 12px; background-color: #faf7f0; }
        .wrapper { width: 100%; padding: 32px 0; }
        .container { max-width: 600px; margin: 0 auto; background-color: #ffffff; border: 1px solid #e9e0d0; border-radius: 10px; }
        .header { padding: 28px 24px 20px; text-align: center; border-bottom: 2px solid #b8a687; }
        .header-name { margin: 0; font-family: Georgia, 'Times New Roman', serif; font-size: 21px; font-weight: bold; color: #7c4a1f; }
        .header-rule { margin: 8px auto 0; width: 72px; border-bottom: 2px solid #e6b762; }
        .content { padding: 32px 32px 24px; color: #2b2118; font-family: -apple-system, 'Segoe UI', Roboto, Arial, sans-serif; font-size: 16px; line-height: 1.6; }
        .content h1 { margin: 0 0 16px; font-family: Georgia, 'Times New Roman', serif; font-size: 26px; line-height: 1.3; color: #2b2118; }
        .content a { color: #7c4a1f; }
        .muted { color: #6e5c49; font-size: 14px; line-height: 1.5; }
        .footer { padding: 16px 24px; color: #6e5c49; font-family: -apple-system, 'Segoe UI', Roboto, Arial, sans-serif; font-size: 13px; line-height: 1.5; text-align: center; border-top: 1px solid #e9e0d0; }
        .footer a { color: #7c4a1f; }
    </style>
</head>
<body>
    <table role="presentation" class="wrapper" width="100%" cellpadding="0" cellspacing="0">
        <tr>
            <td align="center">
                <table role="presentation" class="container" width="600" cellpadding="0" cellspacing="0">
                    <tr>
                        <td class="header">
                            <p class="header-name">{% block header %}{{ communion_name }}{% endblock %}</p>
                            <p class="header-rule">&nbsp;</p>
                        </td>
                    </tr>
                    <tr>
                        <td class="content">{% block content %}{% endblock %}</td>
                    </tr>
                    <tr>
                        <td class="footer">{% block footer %}{{ communion_name }} — message automatique, merci de ne pas y répondre.{% endblock %}</td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
{% endapply %}
