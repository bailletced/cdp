{# Base HTML layout for all emails (F02-T13).
   Draft palette (F01-T01, to be validated by the Communion): brun / crème / blanc.
   primary #6F4526, surface #FAF4E8, text #2E2118, accent (à pourvoir) #B98A5E. #}
{% apply inline_css %}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ communion_name }}{% endblock %}</title>
    <style>
        body { margin: 0; padding: 0; background-color: #FAF4E8; }
        .wrapper { width: 100%; }
        .container { max-width: 600px; margin: 0 auto; background-color: #FFFFFF; }
        .header { background-color: #6F4526; color: #FFFFFF; padding: 24px; font-size: 20px; font-weight: bold; text-align: center; }
        .content { padding: 32px 24px; color: #2E2118; font-size: 16px; line-height: 1.5; }
        .footer { padding: 16px 24px; color: #6F4526; font-size: 13px; text-align: center; border-top: 1px solid #E8DCC8; }
        a { color: #6F4526; }
    </style>
</head>
<body>
    <table role="presentation" class="wrapper" width="100%" cellpadding="0" cellspacing="0">
        <tr>
            <td align="center">
                <table role="presentation" class="container" width="600" cellpadding="0" cellspacing="0">
                    <tr>
                        <td class="header">{% block header %}{{ communion_name }}{% endblock %}</td>
                    </tr>
                    <tr>
                        <td class="content">{% block content %}{% endblock %}</td>
                    </tr>
                    <tr>
                        <td class="footer">{% block footer %}{{ communion_name }} — message automatique, merci de ne pas y répondre.{% endblock %}</td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
{% endapply %}
