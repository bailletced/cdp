includes:
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon

parameters:
    level: max
    # Production code only: the test suite is not analysed by PHPStan
    paths:
        - src
        - config
        - migrations
    excludePaths:
        - var/*
        - vendor/*
        - public/*
        - node_modules/*
    # Doctrine
    dynamicConstantNames:
        - Doctrine\ORM\Mapping\ClassMetadata::CUSTOM_STATE_SAVEPoint
    ignoreErrors:
        # F09-T02 spec'd unsubscribedAt/erasedAt as reserved columns: their
        # writers arrive with F14 (désinscription, RG-EP-1) and F25-T01
        # (Priant::erase(), RG-EP-3). TODO(F14/F25): remove once written.
        -
            identifier: property.unusedType
            path: src/Chain/Domain/Entity/Priant.php
            message: '#Priant::\$unsubscribedAt .* is never assigned#'
        -
            identifier: property.unusedType
            path: src/Chain/Domain/Entity/Priant.php
            message: '#Priant::\$erasedAt .* is never assigned#'
        # The session handler needs its own PDO connections: DBAL's
        # Connection::getParams() is the only way to rebuild an equivalent
        # connection (resolved params include the password and the test dbname
        # suffix). DBAL marks it internal, but it is stable across DBAL 3/4.
        -
            identifier: method.internal
            path: src/Shared/Infrastructure/Symfony/Session/DoctrineSessionPdoFactory.php
            message: '#getParams\(\) from outside its root namespace Doctrine#'
