includes:
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon

parameters:
    level: max
    # Production code only: the test suite is not analysed by PHPStan
    paths:
        - src
        - config
        - migrations
    excludePaths:
        - var/*
        - vendor/*
        - public/*
        - node_modules/*
    # Doctrine
    dynamicConstantNames:
        - Doctrine\ORM\Mapping\ClassMetadata::CUSTOM_STATE_SAVEPoint
