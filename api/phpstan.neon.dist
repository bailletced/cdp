includes:
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon

parameters:
    level: max
    paths:
        - src
        - tests
        - config
        - migrations
    excludePaths:
        - var/*
        - vendor/*
        - public/*
        - node_modules/*
    checkMissingIterableValueType: false

    # Symfony
    stubFiles:
        - vendor/phpstan/phpstan-stubfiles/stubs/Symfony/Component/DependencyInjection/ContainerBuilder.neon

    # Doctrine
    dynamicConstantNames:
        - Doctrine\ORM\Mapping\ClassMetadata::CUSTOM_STATE_SAVEPoint

    # Ignorer les dépréciations Doctrine
    ignoreErrors:
        - '#^Call to an undefined method Doctrine\\.*#'
        - '#^Property Doctrine\\.*#'
        - '#^Method Doctrine\\.*#'
