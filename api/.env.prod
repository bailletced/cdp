# Production environment (F03-T08).
# Secrets are read from Docker Swarm secrets mounted at /run/secrets/.
# The *_FILE variables point to the secret files; Symfony reads them with
# %env(trim:file:...)% processors (see config/packages/prod/).

APP_ENV=prod
APP_DEBUG=0

# Secret file paths (Docker Swarm mounts secrets at /run/secrets/<name>)
APP_SECRET_FILE=/run/secrets/app_secret
DB_PASSWORD_FILE=/run/secrets/db_password
MAILER_DSN_FILE=/run/secrets/mailer_dsn
MERCURE_PUBLISHER_JWT_KEY_FILE=/run/secrets/mercure_publisher_jwt_key
SENTRY_DSN_FILE=/run/secrets/sentry_dsn

# Non-secret prod config
DATABASE_URL="postgresql://app@database:5432/app?serverVersion=18&charset=utf8"
DEFAULT_URI=https://localhost
COMMUNION_NAME="Communion de prière Notre-Dame du Mont-Carmel"
COMMUNION_EMAIL="no-reply@localhost"
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
